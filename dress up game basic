unit Unit5;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.Buttons, Vcl.ExtCtrls,
  Vcl.BaseImageCollection, Vcl.ImageCollection, Vcl.VirtualImage,
  Vcl.Imaging.pngimage;

type
  TForm5 = class(TForm)
    BitBtn1: TBitBtn;
    ComboBox1: TComboBox;
    ImageCollection1: TImageCollection;
    VirtualImageBG: TVirtualImage;
    VirtualImage1: TVirtualImage;
    BitBtn2: TBitBtn;
    VirtualImage2: TVirtualImage;
    ComboBox2: TComboBox;
    ComboBox3: TComboBox;
    procedure FormCreate(Sender: TObject);
    procedure ComboBox1Change(Sender: TObject);
    procedure BitBtn2Click(Sender: TObject);
    procedure ComboBox2Change(Sender: TObject);
    procedure ComboBox3Change(Sender: TObject);


  private
    { Private declarations }
   FIsDragging:boolean;
   Foffset:Integer;
   FoffsetY:Integer;
  public
    { Public declarations }
  end;

var
  Form5: TForm5;

implementation

{$R *.dfm}

procedure TForm5.BitBtn2Click(Sender: TObject);
begin
  close;
end;

procedure TForm5.ComboBox1Change(Sender: TObject);
var
 base:string;
begin
 base:=ExtractFilePath(Application.ExeName)+'images/';
 case Combobox1.itemindex of
   0:VirtualImageBG.Imageindex:=0;
   1:VirtualImageBG.Imageindex:=1;
   2:VirtualImageBG.Imageindex:=2;
   3:VirtualImageBG.Imageindex:=3;
 end;
 case Combobox1.itemindex of
   0:virtualimage1.imageindex:=4;
   1:virtualimage1.imageindex:=5;
   2:virtualimage1.imageindex:=6;
   3:virtualimage1.imageindex:=7;
 end;
end;

procedure TForm5.ComboBox2Change(Sender: TObject);
begin
 case Combobox2.itemindex of
   0:virtualimage2.imageindex:=8;
   1:virtualimage2.imageindex:=9;
   2:virtualimage2.imageindex:=10;
   3:virtualimage2.imageindex:=11;
 end;
end;

procedure TForm5.ComboBox3Change(Sender: TObject);
begin
 case Combobox3.itemindex of
   0:virtualimage1.imageindex:=12;
   1:virtualimage1.imageindex:=4;
   2:virtualimage1.imageindex:=13;
   3:virtualimage1.imageindex:=5;
   4:virtualimage1.imageindex:=14;
   5:virtualimage1.imageindex:=6;
   6:virtualimage1.imageindex:=15;
   7:virtualimage1.imageindex:=7;
 end;
end;

procedure TForm5.FormCreate(Sender: TObject);
begin
VirtualImageBG.SendToBack;
Virtualimage1.BringToFront;
Virtualimage2.bringtofront;
end;
 end.
